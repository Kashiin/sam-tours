# Copy to .env and fill in to deliver site inquiries to Telegram.
# 1. Create a bot with @BotFather and paste its token here.
# 2. Send any message to the bot (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
